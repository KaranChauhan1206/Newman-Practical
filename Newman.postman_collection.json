                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json  = pm.response.json();",
                  "const result = json.result.structuredContent.result;",
                  "",
                  "pm.test('status is error', () => {",
                  "    pm.expect(result.status).to.eql('error');",
                  "})",
                  "",
                  "pm.test('action is cancel_appointment', () => {",
                  "    pm.expect(result.action).to.eql('cancel_appointment');",
                  "})",
                  "",
                  "pm.test('error message says no appointment found', () => {",
                  "    pm.expect(result.message).to.include(\"No appointment found\");",
                  "})",
                  "",
                  "pm.test('details echo back the attempted confirmation_id', () => {",
                  "    pm.expect(result.details).to.have.property('confirmation_id');",
                  "})"
