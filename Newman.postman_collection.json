          "name": "1b - Confirm Booking (Same Session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json  = pm.response.json();",
                  "const result = json.result.structuredContent.result;",
                  "",
                  "pm.test('status is complete', () => {",
                  "    pm.expect(result.status).to.eql('complete');",
                  "})",
                  "",
                  "pm.test('action is create_appointment', () => {",
                  "    pm.expect(result.action).to.eql('create_appointment');",
                  "})",
                  "",
                  "pm.test('confirmation_id present in details', () => {",
                  "    pm.expect(result.details).to.have.property('confirmation_id');",
                  "})",
                  "",
                  "pm.test('message contains Confirmation', () => {",
                  "    pm.expect(result.message).to.include('Confirmation');",
                  "})",
                  "",
                  "// Capture confirmation_id — reused in Scenario 3 to drive the cancel request\",",
                  "pm.collectionVariables.set('lastConfirmationId', result.details.confirmation_id);"
                ],
