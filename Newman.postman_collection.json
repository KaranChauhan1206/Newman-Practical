              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"schedule_agent\",\n    \"arguments\": { \"user_request\": \"I need an oil change at 9am\" }\n  }\n}",
